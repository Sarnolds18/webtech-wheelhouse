<!DOCTYPE html>
<html>
  <head>
    <title>Wheelhouse</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg bg-primary navbar-dark">
      <div class="container">
        <%= link_to "Wheelhouse", root_path, class: "navbar-brand fw-bold" %>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNavbar"
          aria-controls="mainNavbar"
          aria-expanded="false"
          aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav ms-auto">

            <li class="nav-item">
              <%= link_to "Home",
                  root_path,
                  class: "nav-link #{'active' if current_page?(root_path)}" %>
            </li>

            <li class="nav-item">
              <%= link_to "Services",
                  services_path,
                  class: "nav-link #{'active' if current_page?(services_path)}" %>
            </li>

            <li class="nav-item">
              <%= link_to "Visit",
                  visiting_path,
                  class: "nav-link #{'active' if current_page?(visiting_path)}" %>
            </li>

            <li class="nav-item">
              <%= link_to "About",
                  about_path,
                  class: "nav-link #{'active' if current_page?(about_path)}" %>
            </li>

          </ul>
        </div>
      </div>
    </nav>

    <main class="container py-5">
      <%= yield %>
    </main>
  </body>
</html>