<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} — Wheelhouse" : "Wheelhouse" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg bg-white border-bottom">
      <div class="container">
        <%# A visitor's bar links to no page that requires a session, so their brand goes to the price list. %>
        <%= link_to (authenticated? ? root_path : services_path), class: "navbar-brand fw-bold" do %>
          <i class="bi bi-bicycle me-2" aria-hidden="true"></i>Wheelhouse
        <% end %>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNavbar"
          aria-controls="mainNavbar"
          aria-expanded="false"
          aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav ms-auto">

            <% if authenticated? %>
            <li class="nav-item">
              <%= link_to "Home",
                  root_path,
                  class: "nav-link #{'text-primary fw-semibold' if current_page?(root_path)}" %>
            </li>
            <% end %>

            <li class="nav-item">
              <%= link_to "Services",
                  services_path,
                  class: "nav-link #{'text-primary fw-semibold' if current_page?(services_path)}" %>
            </li>

            <% if authenticated? %>

            <li class="nav-item">
              <%= link_to "Customers",
                  customers_path,
                  class: "nav-link #{'text-primary fw-semibold' if current_page?(customers_path)}" %>
            </li>

            <li class="nav-item">
              <%= link_to "Bikes",
                  bikes_path,
                  class: "nav-link #{'text-primary fw-semibold' if current_page?(bikes_path)}" %>
            </li>

            <li class="nav-item">
              <%= link_to "Repairs",
                  repairs_path,
                  class: "nav-link #{'text-primary fw-semibold' if current_page?(repairs_path)}" %>
            </li>

            <li class="nav-item">
              <%= link_to "Staff",
                  mechanics_path,
                  class: "nav-link #{'text-primary fw-semibold' if current_page?(mechanics_path)}" %>
            </li>

            <li class="nav-item">
              <%= link_to "Visit",
                  visiting_path,
                  class: "nav-link #{'text-primary fw-semibold' if current_page?(visiting_path)}" %>
            </li>

            <li class="nav-item">
              <%= link_to "About",
                  about_path,
                  class: "nav-link #{'text-primary fw-semibold' if current_page?(about_path)}" %>
            </li>
            <% end %>

          </ul>

          <%# Who is at the keyboard, and a control to leave. Signing out is a DELETE, never a GET. %>
          <div class="d-flex flex-wrap align-items-center gap-2 ms-lg-4 mt-2 mt-lg-0">
            <% if authenticated? %>
              <span class="navbar-text">
                <i class="bi bi-person-circle me-1" aria-hidden="true"></i><%= Current.user.display_name %>
                <span class="badge text-bg-light border ms-1"><%= Current.user.role.humanize %></span>
              </span>
              <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-sm btn-outline-secondary",
                                                      form_class: "d-inline" %>
            <% else %>
              <%= link_to "Sign in", new_session_path, class: "btn btn-sm btn-primary" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <main class="container py-5">
      <% { notice: "alert-success", alert: "alert-danger" }.each do |type, alert_class| %>
        <% if flash[type].present? %>
          <div class="alert <%= alert_class %> alert-dismissible fade show" role="alert">
            <%= flash[type] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>