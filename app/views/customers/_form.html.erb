<%= form_with model: customer do |form| %>
  <%= render "shared/error_summary", record: customer %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: field_class(form, :name) %>
    <%= field_errors(form, :name) %>
  </div>

  <div class="mb-3">
    <%= form.label :phone, class: "form-label" %>
    <%= form.text_field :phone, class: field_class(form, :phone) %>
    <%= field_errors(form, :phone) %>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", cancel_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
