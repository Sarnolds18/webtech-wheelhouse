<% content_for :title, @customer.name %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="mb-0"><%= @customer.name %></h1>

  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_customer_path(@customer), class: "btn btn-primary" %>
    <%= button_to "Delete", @customer, method: :delete, class: "btn btn-outline-danger",
                  form: { data: { turbo_confirm: "Delete customer #{@customer.name}?" } } %>
  </div>
</div>

<p class="lead"><%= @customer.phone %></p>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4 mb-2">
  <h2 class="h4 mb-0">Bikes</h2>
  <%= link_to "Add bike", new_bike_path(customer_id: @customer.id), class: "btn btn-sm btn-outline-primary" %>
</div>

<% if @customer.bikes.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th scope="col">Serial number</th>
          <th scope="col">Model</th>
          <th scope="col">Owner</th>
        </tr>
      </thead>

      <tbody>
        <%= render @customer.bikes %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No bikes on record for this customer yet.</p>
<% end %>

<%= link_to "Back to customers", customers_path, class: "btn btn-outline-primary" %>
