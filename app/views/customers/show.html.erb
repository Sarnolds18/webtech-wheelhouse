<% content_for :title, @customer.name %>

<h1><%= @customer.name %></h1>

<p class="lead"><%= @customer.phone %></p>

<h2 class="h4 mt-4">Bikes</h2>

<% if @customer.bikes.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th scope="col">Serial number</th>
          <th scope="col">Model</th>
          <th scope="col">Owner</th>
        </tr>
      </thead>

      <tbody>
        <%= render @customer.bikes %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No bikes on record for this customer yet.</p>
<% end %>

<%= link_to "Back to customers", customers_path, class: "btn btn-outline-primary" %>
