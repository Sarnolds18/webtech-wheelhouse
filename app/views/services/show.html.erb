<% content_for :title, @service.name %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="mb-0"><%= @service.name %></h1>

  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_service_path(@service), class: "btn btn-primary" %>
    <%= button_to "Delete", @service, method: :delete, class: "btn btn-outline-danger",
                  form: { data: { turbo_confirm: "Delete service #{@service.name}?" } } %>
  </div>
</div>

<p class="lead">
  <%= @service.category || "Other services" %>
</p>

<dl class="row">
  <dt class="col-sm-3">Price</dt>
  <dd class="col-sm-9 text-tabular">
    <%= number_to_currency(@service.price, unit: "$", precision: 0, delimiter: ".") %>
  </dd>
</dl>

<%= link_to "Back to services", services_path, class: "btn btn-outline-primary" %>
