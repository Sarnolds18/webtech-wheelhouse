<%= form_with model: service do |form| %>
  <%= render "shared/error_summary", record: service %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: field_class(form, :name) %>
    <%= field_errors(form, :name) %>
  </div>

  <div class="mb-3">
    <%= form.label :price, "Price (CLP)", class: "form-label" %>
    <%= form.number_field :price, class: field_class(form, :price) %>
    <%= field_errors(form, :price) %>
  </div>

  <div class="mb-3">
    <%= form.label :category, class: "form-label" %>
    <%= form.text_field :category, class: field_class(form, :category), aria: { describedby: "service_category_help" } %>
    <div id="service_category_help" class="form-text">Leave it empty to list the service under "Other services".</div>
    <%= field_errors(form, :category) %>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", cancel_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
