<% if record.errors.any? %>
  <div class="alert alert-danger" role="alert">
    <h2 class="h6">
      <%= pluralize(record.errors.count, "problem") %> kept this <%= record.model_name.human.downcase %> from being saved:
    </h2>

    <ul class="mb-0">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
