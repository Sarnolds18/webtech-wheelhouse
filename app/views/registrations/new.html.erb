<% content_for :title, "Sign up" %>

<div class="row justify-content-center">
  <div class="col-md-8 col-lg-5">
    <h1>Sign up</h1>
    <p class="text-secondary">An account for the people of the workshop. The owner gives it its role.</p>

    <%= form_with model: @user, url: registration_path do |form| %>
      <%= render "shared/error_summary", record: @user %>

      <div class="mb-3">
        <%= form.label :email_address, "Email address", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                                             class: field_class(form, :email_address) %>
        <%= field_errors(form, :email_address) %>
      </div>

      <div class="mb-3">
        <%= form.label :password, class: "form-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
                                           class: field_class(form, :password),
                                           aria: { describedby: "user_password_help" } %>
        <div id="user_password_help" class="form-text">
          At least <%= User::PASSWORD_MINIMUM_LENGTH %> characters.
        </div>
        <%= field_errors(form, :password) %>
      </div>

      <div class="mb-3">
        <%= form.label :password_confirmation, "Repeat the password", class: "form-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
                                                        class: field_class(form, :password_confirmation) %>
        <%= field_errors(form, :password_confirmation) %>
      </div>

      <%= form.submit "Create the account", class: "btn btn-primary" %>
    <% end %>

    <p class="mt-4 mb-0">Already have an account? <%= link_to "Sign in", new_session_path %></p>
  </div>
</div>
