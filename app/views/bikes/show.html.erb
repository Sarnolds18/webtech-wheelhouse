<% content_for :title, @bike.serial_number %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="mb-0"><%= @bike.serial_number %></h1>

  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_bike_path(@bike), class: "btn btn-primary" %>
    <%= button_to "Delete", @bike, method: :delete, class: "btn btn-outline-danger",
                  form: { data: { turbo_confirm: "Delete bike #{@bike.serial_number}?" } } %>
  </div>
</div>

<dl class="row">
  <dt class="col-sm-3">Model</dt>
  <dd class="col-sm-9"><%= @bike.bike_model.brand %> <%= @bike.bike_model.name %></dd>

  <dt class="col-sm-3">Owner</dt>
  <dd class="col-sm-9"><%= link_to @bike.customer.name, customer_path(@bike.customer) %></dd>
</dl>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4 mb-2">
  <h2 class="h4 mb-0">Repairs</h2>
  <%= link_to "New repair", new_repair_path(bike_id: @bike.id), class: "btn btn-sm btn-outline-primary" %>
</div>

<% if @bike.repairs.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th scope="col">Photo</th>
          <th scope="col">Bike</th>
          <th scope="col">Customer</th>
          <th scope="col">State</th>
          <th scope="col">Promised</th>
        </tr>
      </thead>

      <tbody>
        <%= render @bike.repairs %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>This bike has never been in for a repair.</p>
<% end %>

<%= link_to "Back to bikes", bikes_path, class: "btn btn-outline-primary" %>
