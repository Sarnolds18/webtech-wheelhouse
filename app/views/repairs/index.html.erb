<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="mb-0">Repairs</h1>
  <% if policy(Repair).new? %>
    <%= link_to "New repair", new_repair_path, class: "btn btn-primary" %>
  <% end %>
</div>

<%# A GET form: the filters are chained on the reader's scope, so a mechanic filters only their own repairs. %>
<%= form_with url: repairs_path, method: :get, class: "row g-2 align-items-end mb-4" do |form| %>
  <div class="col-sm-auto">
    <%= form.label :state, "State", class: "form-label" %>
    <%= form.select :state, Repair.states.keys.map { |state| [ state.humanize, state ] },
                    { include_blank: "Any state", selected: @state }, class: "form-select" %>
  </div>
  <div class="col-sm-auto">
    <div class="form-check mb-2">
      <%= form.check_box :overdue, { checked: @overdue, class: "form-check-input" }, "1", nil %>
      <%= form.label :overdue, "Only overdue", class: "form-check-label" %>
    </div>
  </div>
  <div class="col-sm-auto d-flex gap-2">
    <%= form.submit "Filter", name: nil, class: "btn btn-outline-primary" %>
    <% if @state || @overdue %>
      <%= link_to "Clear", repairs_path, class: "btn btn-link" %>
    <% end %>
  </div>
<% end %>

<% if @repairs.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th scope="col">Repair</th>
          <th scope="col">Photo</th>
          <th scope="col">Bike</th>
          <th scope="col">Customer</th>
          <th scope="col">State</th>
          <th scope="col">Promised</th>
          <th scope="col">Diagnosis</th>
          <th scope="col">Taken in by</th>
        </tr>
      </thead>

      <tbody>
        <%= render @repairs %>
      </tbody>
    </table>
  </div>
<% else %>
  <p><%= @state || @overdue ? "No repairs match these filters." : "No repairs on record yet." %></p>
<% end %>
