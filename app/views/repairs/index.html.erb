<h1>Repairs</h1>

<% if @repairs.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th scope="col">Bike</th>
          <th scope="col">Customer</th>
          <th scope="col">State</th>
          <th scope="col">Promised</th>
        </tr>
      </thead>

      <tbody>
        <%= render @repairs %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No repairs on record yet.</p>
<% end %>
