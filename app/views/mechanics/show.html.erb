<% content_for :title, @mechanic.name %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="mb-0"><%= @mechanic.name %></h1>

  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_mechanic_path(@mechanic), class: "btn btn-primary" %>
    <%= button_to "Delete", @mechanic, method: :delete, class: "btn btn-outline-danger",
                  form: { data: { turbo_confirm: "Delete staff member #{@mechanic.name}? Their repairs will be left unassigned." } } %>
  </div>
</div>

<h2 class="h4 mt-4">Repairs assigned</h2>

<% if @mechanic.repairs.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th scope="col">Photo</th>
          <th scope="col">Bike</th>
          <th scope="col">Customer</th>
          <th scope="col">State</th>
          <th scope="col">Promised</th>
        </tr>
      </thead>

      <tbody>
        <%= render @mechanic.repairs %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No repairs assigned yet.</p>
<% end %>

<%= link_to "Back to staff", mechanics_path, class: "btn btn-outline-primary" %>
