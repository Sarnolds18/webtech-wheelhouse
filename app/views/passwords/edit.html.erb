<% content_for :title, "Choose a new password" %>

<div class="row justify-content-center">
  <div class="col-md-8 col-lg-5">
    <h1>Choose a new password</h1>

    <%= form_with model: @user, url: password_path(params[:token]), method: :put do |form| %>
      <%= render "shared/error_summary", record: @user %>

      <div class="mb-3">
        <%= form.label :password, "New password", class: "form-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
                                           class: field_class(form, :password),
                                           aria: { describedby: "user_password_help" } %>
        <div id="user_password_help" class="form-text">
          At least <%= User::PASSWORD_MINIMUM_LENGTH %> characters.
        </div>
        <%= field_errors(form, :password) %>
      </div>

      <div class="mb-3">
        <%= form.label :password_confirmation, "Repeat the new password", class: "form-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
                                                        class: field_class(form, :password_confirmation) %>
        <%= field_errors(form, :password_confirmation) %>
      </div>

      <%= form.submit "Save the new password", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
